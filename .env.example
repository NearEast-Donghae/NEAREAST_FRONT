# 이 파일을 복사해서 .env 로 만든 뒤 값을 채워 넣으세요.
#   cp .env.example .env      (Windows: copy .env.example .env)
# 키를 바꾼 뒤에는 개발 서버를 다시 시작해야 반영됩니다.
# Vite는 VITE_ 접두사가 붙은 변수만 브라우저 코드에 노출합니다.

# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키
VITE_KAKAO_MAP_KEY=

# ── 백엔드 (NEAREAST_BACK) ──
# 개발 서버는 /api 요청을 백엔드(http://127.0.0.1:8012)로 넘깁니다 (vite.config.ts 프록시).
# 그래서 API 주소는 비워 두면 '/api/v1'을 씁니다. 다른 주소를 쓸 때만 적으세요.
# VITE_API_BASE_URL=/api/v1

# 회원가입·로그인·나의 여행 일정을 백엔드에 연결 — false 면 백엔드, true 면 백엔드 없이 데모 인증(브라우저 저장)
VITE_USE_MOCK_AUTH=false

# AI 여행 플래너 챗봇·대화 목록을 백엔드에 연결 — false 면 백엔드, true 면 프론트 내장 데모 응답
VITE_USE_MOCK_CHAT=false
