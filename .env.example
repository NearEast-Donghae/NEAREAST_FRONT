# 이 파일을 복사해서 .env 로 만든 뒤 값을 채워 넣으세요.
#   cp .env.example .env      (Windows: copy .env.example .env)
# 키를 바꾼 뒤에는 개발 서버를 다시 시작해야 반영됩니다.
# Vite는 VITE_ 접두사가 붙은 변수만 브라우저 코드에 노출합니다.

# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키
VITE_KAKAO_MAP_KEY=

# 백엔드 REST API 주소 (끝에 / 없이)
VITE_API_BASE_URL=http://localhost:8080/api

# AI 여행 플래너 챗봇 — 백엔드 POST /chat 이 준비되면 false 로 바꾸세요 (형식: docs/chat-api.md)
# true 또는 비워 두면 프론트에 내장된 데모 응답을 씁니다.
VITE_USE_MOCK_CHAT=true

# 회원가입·로그인 — 백엔드 /auth API 가 준비되면 false 로 바꾸세요 (형식: docs/auth-api.md)
# true 또는 비워 두면 데모 인증을 씁니다 (비밀번호는 확인·저장하지 않음).
VITE_USE_MOCK_AUTH=true
